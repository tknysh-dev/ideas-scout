<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ideas-scout.telegram-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__REPO__/agents/scripts/telegram-bot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <!-- Не за розкладом, а постійно: демон живе весь час і сам ходить у Telegram
         (long-polling). KeepAlive піднімає його після падіння, сну чи логіну.
         Це user-agent, а не системний демон — саме тому доступний Keychain
         власника з токеном бота. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__REPO__/logs/launchd/telegram-bot.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/launchd/telegram-bot.launchd.log</string>
</dict>
</plist>
