; Явний набір правил sqlfluff для shared/schema.sql і shared/migrations/*.sql —
; той самий підхід, що й у ruff.toml: набір зафіксований явно, а не залежить
; від версії лінтера чи дефолтів.
;
; Виміряно на реальних файлах (460 рядків schema.sql + 7 міграцій): повний
; набір правил sqlfluff дає 548 зауважень, з них 528 — форматування, яке в
; цьому проєкті нікого не турбує (LT02 — очікує 4-пробільний відступ, тут 2;
; LT05 — рядок довший за 80 символів, тут навмисно довгі рядки, той самий
; аргумент, що й E501 у ruff.toml; LT01/LT14 — пробіли й перенос перед WHERE;
; RF04 "keywords as identifiers" — фарбує звичайнісінькі назви колонок на
; кшталт type/name/provider/model/stage, які не є зарезервованими словами
; postgres і не створюють жодної реальної двозначності).
;
; Єдине правило з реальним змістом на цих файлах — PG01 (postgres.
; excessive_locks): ADD CONSTRAINT ... FOREIGN KEY без NOT VALID і CREATE
; INDEX без CONCURRENTLY лочать таблицю на час валідації/побудови індексу.
; Дало 18 попереджень — усі в уже накочених на бойову базу schema.sql і
; migrations/*.sql. Тут це свідомо не виправлено (apply.sh ці файли вже
; застосував, а schema.sql — лише дзеркало поточного стану бази, не
; виконуваний код) — але те саме правило зловить проблему в НОВІЙ міграції
; до того, як її накотять на прод.
[sqlfluff]
dialect = postgres
rules = PG01
; schema.sql — 26416 байт, за замовчуванням sqlfluff пропускає файли понад
; 20000 байт (large_file_skip_byte_limit), щоб не тримати парсер надовго.
large_file_skip_byte_limit = 0
