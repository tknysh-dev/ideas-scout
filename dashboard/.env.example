# Дані Supabase — тільки server-side, обов'язкові.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Telegram надсилає цей секрет у заголовку кожного webhook-запиту. Те саме
# значення треба додати в ~/.config/ideas-scout/env на M1 перед реєстрацією webhook.
# Згенерувати: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Вхід у дашборд — GitHub OAuth через Auth.js. Усі чотири обов'язкові у проді:
# без них proxy закриває дашборд повністю (у dev — пускає, з банером у сайдбарі).
# AUTH_SECRET — згенерувати: npx auth secret
# AUTH_GITHUB_ID / AUTH_GITHUB_SECRET — GitHub → Settings → Developer settings →
#   OAuth Apps; callback URL: https://<домен>/api/auth/callback/github
# ALLOWED_GITHUB_LOGIN — єдиний GitHub-username, якому дозволено вхід
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ALLOWED_GITHUB_LOGIN=

# GitHub API — для сторінки /config у режимі CONFIG_SOURCE=github.
GITHUB_TOKEN=

# Джерело сторінки /config: local (робоча копія, видно незакомічені правки) або
# github (гілка main через API). Типово: local у dev, github у проді — задавати
# вручну треба лише щоб перевірити локально прод-поведінку чи навпаки.
CONFIG_SOURCE=
CONFIG_LOCAL_ROOT=
