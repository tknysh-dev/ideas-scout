{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test src/lib/*.test.mts && vitest run",
    "coverage:node": "c8 --reporter=text --reporter=json --report-dir=coverage/node --extension=.ts --extension=.tsx --extension=.mts --exclude=\"src/**/*.test.mts\" --exclude=\"src/lib/telegram-webhook-route.mock-service.mts\" --exclude=\"src/lib/telegram-webhook-route.hooks.mjs\" --include=\"src/lib/**\" node --test src/lib/*.test.mts",
    "coverage:vitest": "vitest run --coverage",
    "coverage": "npm run coverage:node && npm run coverage:vitest && node scripts/merge-coverage.mjs",
    "deadcode": "knip"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/typography": "^0.5.20",
    "mermaid": "^11.16.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/hast": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "c8": "^12.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^29.1.1",
    "knip": "^6.31.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
