registries/passive-income/ideas.md
registries/app-ideas/ideas.md
.DS_Store

# Рантайм-артефакти інфраструктури виконання (Фаза 6) — не мають потрапляти в git.
# logs/quarantine/*.diff — потенційно атакерський вміст (guard проти промпт-ін'єкції),
# його не можна тягнути в історію; .gitkeep у кожній теці лишається трекованим.
logs/locks/*
!logs/locks/.gitkeep
logs/launchd/*.log
logs/quarantine/*
!logs/quarantine/.gitkeep

# Статуси прогонів — локальний стан машини, не переносяться між машинами
logs/status/*.json

# Reddit-кеш — сирі дампи передкачування (agents/scripts/reddit-fetch.sh), не комітяться
logs/runs/reddit-cache/

# Рядки прогресу тріажу — живуть хвилини, лише щоб бот показав стан у чаті.
# Сам вердикт (logs/triage/*.md) і вхідний матеріал (inbox/) комітяться.
logs/triage/*.progress

# Байт-код Python (agents/scripts/telegram-bot.py)
__pycache__/

# Кеш ruff — локальний, створюється при кожному прогоні check.sh
.ruff_cache/

# Артефакти coverage.py (agents/scripts) — локальний вимір, не переноситься
agents/scripts/.coverage
agents/scripts/htmlcov/

# Тимчасова тека Stryker (npm run test:mutation --prefix agents/worker) —
# бекап вихідника на час прогону, більше нема чого туди класти.
agents/worker/.stryker-tmp/

# Звіти kcov — покриття bash, збирається локально через check.sh --coverage
agents/scripts/.kcov-out/

# Встановлюються локально на кожній машині через install-launchd.sh.
agents/worker/node_modules/

# Робочий стан Claude Code: .claude/worktrees/ — тимчасові git-worktree окремих
# сесій, тобто повна копія репозиторію всередині нього самого.
.claude/
