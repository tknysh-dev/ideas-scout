<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ideas-scout.monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/monitor.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <!-- Щодня 09:30 (PLAN.md, Фаза 6: моніторинг) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__REPO__/logs/launchd/monitor.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/launchd/monitor.launchd.log</string>
</dict>
</plist>
