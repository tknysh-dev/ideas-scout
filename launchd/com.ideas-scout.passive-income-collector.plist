<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ideas-scout.passive-income-collector</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/runner.sh</string>
        <string>--track</string>
        <string>passive-income</string>
        <string>--agent</string>
        <string>collector</string>
        <string>--provider</string>
        <string>claude</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <!-- Пн/Ср/Пт 03:00 (PLAN.md, Фаза 6: збирач пн/ср/пт вночі) -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>3</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>3</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>3</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__REPO__/logs/launchd/passive-income-collector.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/launchd/passive-income-collector.launchd.log</string>
</dict>
</plist>
