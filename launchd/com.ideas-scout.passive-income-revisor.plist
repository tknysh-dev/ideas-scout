<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ideas-scout.passive-income-revisor</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/runner.sh</string>
        <string>--track</string>
        <string>passive-income</string>
        <string>--agent</string>
        <string>revisor</string>
        <string>--provider</string>
        <string>claude</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <!-- Ср/Сб 06:00 — 2×/тиждень (PLAN.md Фаза 5), до вікна заборони власника (07:00-20:00);
         у сб — через годину після аналітика (05:00), git-лок і так розведе їх, але година
         запасу краща за тісний стик розкладів. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>6</integer>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>IDEAS_SCOUT_WORK_DAYS</key>
        <string>1,2,3,4,5</string>
        <key>IDEAS_SCOUT_WORK_HOURS</key>
        <string>07:00-20:00</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__REPO__/logs/launchd/passive-income-revisor.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/launchd/passive-income-revisor.launchd.log</string>
</dict>
</plist>
