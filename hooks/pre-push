#!/usr/bin/env bash
# Pre-push хук: повний ./check.sh перед тим, як код піде в remote.
# Це головна брама якості — усі тести, типи, lint, збірка і сторожі. Коміт
# лишається дешевим (там лише пошук секретів), а зупиняємось на межі, за якою
# зміни вже бачить не тільки ця машина.
# Перевірка версіонується в репозиторії (hooks/) і включається
# командою: git config core.hooksPath hooks (на кожній машині окремо).
# Як обійти: git push --no-verify

set -uo pipefail

# Git подає список refs на stdin. Він тут не потрібен, але його треба
# вичитати: інакше git отримає EPIPE, коли хук завершиться раніше.
cat >/dev/null

REPO_ROOT="$(git rev-parse --show-toplevel)"
CHECK_SCRIPT="$REPO_ROOT/check.sh"

if [[ ! -f "$CHECK_SCRIPT" ]] || [[ ! -x "$CHECK_SCRIPT" ]]; then
	echo "⚠️  Немає виконуваного $CHECK_SCRIPT — перевірку пропущено." >&2
	echo "   Push не блокується: поломка самого хука не має зупиняти роботу." >&2
	exit 0
fi

# Статус береться окремим рядком, а не з $? усередині `if ! …`: там $? —
# це результат заперечення, тобто завжди 0, і хук пропускав би push.
"$CHECK_SCRIPT"
STATUS=$?
if [ "$STATUS" -ne 0 ]; then
	echo "❌ Перевірка не пройшла — push зупинено. Полагодь помилки вище." >&2
	echo "   Щоб обійти хук цього разу: git push --no-verify" >&2
	exit "$STATUS"
fi
